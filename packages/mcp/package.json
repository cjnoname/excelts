{
  "name": "@documonster/mcp",
  "version": "0.10.0",
  "description": "Model Context Protocol server for documonster — lets AI assistants read, write and convert Excel, Word, PDF, CSV and ZIP documents.",
  "keywords": [
    "ai",
    "claude",
    "csv",
    "docx",
    "excel",
    "llm",
    "mcp",
    "model-context-protocol",
    "pdf",
    "xlsx"
  ],
  "homepage": "https://github.com/documonster/documonster/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/documonster/documonster/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "cjnoname",
    "email": "powerfulj87@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/documonster/documonster.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "documonster-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "type": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node src/examples/setup-workspace.ts",
    "example:probe": "node src/examples/probe-tools.ts",
    "start": "node dist/cli.js",
    "dev": "node --experimental-strip-types src/cli.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "documonster": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
