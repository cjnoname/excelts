#!/usr/bin/env sh
# Pre-commit hook: format, lint, and type-check the whole project.
#
# 1. Check formatting without modifying the working tree or index.
# 2. Run `pnpm lint` and `pnpm type` in parallel. If either fails, abort
#    the commit so broken code never lands on a branch.

set -e

echo "[pre-commit] 1/3 checking formatting…"
# Never auto-stage from a hook: doing so converts a partially staged file into
# a fully staged one (and shell word splitting also breaks filenames with
# spaces). The hook is a gate, not an editor; run `pnpm format`, inspect, and
# stage the result deliberately.
pnpm exec oxfmt --check

# Type-aware oxlint follows satellite imports through the core's public exports
# map, so a clean checkout needs dist/types even when the root tsc excludes
# packages/*. Build only the ESM/types target, not the full browser/CJS matrix.
if [ ! -d "dist/types" ]; then
  echo "[pre-commit]   building core ESM/types for workspace-package lint…"
  pnpm -s build:esm
fi

echo "[pre-commit] 2/3 running lint + type in parallel…"
# Reuse the concurrently binary (already a devDependency). Using
# `pnpm exec` avoids hard-coding the path; both commands run in parallel
# and the first failure fails the whole step.
#
# `verify:packages` is included because it is a pure source scan (no build
# needed), so it costs nothing and catches a satellite package reaching into
# the core's internals before it can land.
pnpm exec concurrently --raw --kill-others-on-fail \
  "pnpm -s lint" \
  "pnpm -s type" \
  "pnpm -s verify:packages"

# Satellite packages resolve `documonster` through its published exports map,
# so type-checking them requires dist/types to exist. Run it when it does —
# skipping unconditionally would let a type error in packages/* sail through to
# CI, while requiring it unconditionally would break the hook on a fresh clone.
if [ -d "dist/types" ]; then
  echo "[pre-commit] 2b/3 type-checking workspace packages…"
  pnpm -s type:packages
else
  echo "[pre-commit] 2b/3 skipping type:packages — no dist/types (run 'pnpm build:esm' to enable)"
fi

echo "[pre-commit] 3/3 done — proceeding with commit."
